{
  "name": "entropia-biological-evolution-sandbox",
  "private": true,
  "version": "2.5.0",
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "concurrently \"pnpm run dev:app\" \"pnpm run dev:logs\"",
    "dev:app": "vite",
    "dev:logs": "tsx scripts/log-server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:dead-code": "knip",
    "check:tooling": "jiti scripts/ensure-typescript-tooling.ts",
    "check:canon": "pnpm run check:dead-code && pnpm run depcruise && pnpm run check:tooling",
    "check": "pnpm run typecheck && pnpm run test --run --coverage && pnpm run depcruise && pnpm run build",
    "check:strict": "pnpm run typecheck && pnpm run lint && pnpm run check:canon && pnpm run test --run --coverage && pnpm run build",
    "prepare": "husky",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:smoke": "playwright test",
    "audit:prod": "pnpm audit --prod --audit-level=high",
    "docker:up": "docker compose up -d",
    "docker:rebuild": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:typecheck": "docker compose exec dev pnpm run typecheck",
    "docker:test": "docker compose exec dev pnpm run test --run",
    "depcruise": "depcruise src --config .dependency-cruiser.mjs --output-type err"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "recharts": "^3.6.0",
    "three": "^0.182.0",
    "three-stdlib": "^2.36.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.3",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.182.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "2.1.9",
    "@vitest/ui": "^2.1.8",
    "autoprefixer": "^10.4.23",
    "concurrently": "^10.0.6",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-sonarjs": "^3.0.5",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "jsdom": "^25.0.1",
    "knip": "^6.16.1",
    "lint-staged": "16.2.7",
    "postcss": "8.5.10",
    "tailwindcss": "^4.1.18",
    "terser": "^5.44.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.50.1",
    "vite": "8.1.6",
    "vite-plugin-checker": "^0.12.0",
    "vitest": "^2.1.8",
    "ws": "^8.21.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings 0"
    ]
  }
}
